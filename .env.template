# Copy to .env and fill in. .env is gitignored.

# Phase 1 — markdown corpus
MD_CORPUS_DIR=/path/to/markdown/corpus
AUTHOR_NAME=Firstname Lastname   # UI header, answer prompt, frontmatter author fallback

# Phase 2 — site authentication (no credentials: you sign in yourself when asked)
LOGIN_URL=https://www.example.com/login
HEALTH_CHECK_URL=https://www.example.com/members/   # a members-only page; required
SITE_DOMAIN=example.com                             # cookie-attach allowlist; required
SUCCESS_SELECTOR=.member-content                    # optional; CSS present only when logged in
INTERACTIVE_LOGIN=auto        # auto | always | never
                              # always -> for the Streamlit app on your own desktop
                              # never  -> for cron/servers; fails fast instead of waiting

# Phase 2 — email reader
TRUSTED_SENDER=author@example.com
EMAIL_SUBJECT_PATTERN=premium report   # optional; case-insensitive match on the subject
IMAP_USERNAME=you@gmail.com           # imap backend only
IMAP_APP_PASSWORD=xxxx xxxx xxxx      # imap backend only

# Storage — Qdrant vector database (SQLite metadata/cache dirs are auto-created)
# Pick ONE mode. Default (nothing set) connects to a server on localhost:6333.
QDRANT_PATH=data/qdrant        # embedded on-disk store, no server needed (recommended for one user)
# QDRANT_IN_MEMORY=true        # ephemeral — everything is lost on exit; for quick trials only
# QDRANT_HOST=localhost        # server mode: host + port of a running Qdrant
# QDRANT_PORT=6333

# LLM providers — set only the keys for your chosen backends
ANTHROPIC_API_KEY=sk-ant-...          # LLM_BACKEND or VISION_BACKEND = "anthropic"
OPENAI_API_KEY=sk-...                 # LLM_BACKEND or EMBEDDING_BACKEND = "openai"
OPENAI_COMPAT_API_KEY=...             # openai_compat cloud (Together.ai, Groq, Fireworks)
EMBEDDING_API_KEY=...                 # separate key if embedding uses another provider
# Local backends (Ollama, vLLM): no API key needed
# Set OPENAI_COMPAT_API_KEY=ollama (literal) for Ollama
